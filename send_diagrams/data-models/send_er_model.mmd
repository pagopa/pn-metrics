%% source: logical mapping notifications-timeline-request + dc-pn-EcRichiesteMetadati.yaml (PN-EC minimal FK)
%%{init: {
  "theme": "base",
  "themeVariables": {
    "labelBackgroundColor": "#FFFFFF",
    "labelTextColor": "#000000",
    "entityBkgColor": "#FFFFFF",
    "attributeBkgColor": "#FFFFFF",
