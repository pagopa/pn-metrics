    %% CONVENZIONI
    %% - Sono riportate esclusivamente le entità principali
    %% - Sono riportati solamente attributi PK e FK
    %% - Le cardinalità derivano dai diagrammi di dettaglio dei singoli domini
    %% - I commenti descrivono la logica di correlazione tra le entità

    Direction LR

    NotificationsRequest {
        STRING iun PK "NOT NULL"
        STRING requestId FK
    }

    pn_Notifications {
        STRING iun PK
        ARRAY recipients
    }

    pn_Timeline {
        STRING timelineElementId PK
        STRING iun FK
        INT recIndex FK
    }

    RaddRegistryV2 {
        STRING partnerId PK
        STRING locationId PK
    }

    RaddTransactionEntity {
        STRING transactionId PK
        STRING operationType PK
        STRING iun FK
        STRING partnerId FK
        STRING locationId FK
    }

    OperationsIunEntity {
        STRING transactionId PK
        STRING iun PK
    }

    pn_EcAnagrafica {
        STRING cxId PK
    }

    pn_EcRichieste {
        STRING requestId PK
        STRING XPagopaExtchCxId FK
    }

    pn_EcRichiesteMetadati {
        STRING requestId PK
        STRING XPagopaExtchCxId FK
    }

    pn_EcRichiesteConversione {
        STRING requestId PK
    }

    pn_EcConversionePDF {
        STRING fileKey PK
        STRING requestId FK
    }

    pn_UserAttributes {
        STRING recipientId PK
    }

    Deleghe {
        STRING sk PK
        STRING Deleghe_pk PK
        STRING s_delegate FK
        STRING s_mandateid
    }

        NotificationInformal {
        STRING iun PK
        STRING requestId FK
        STRING campaignId FK
    }

    TimelinesInformal {
        STRING timelineElementId PK
        STRING iun FK
        INT recIndex FK
        STRING campaignId FK
    }

    Campaigns {
        STRING senderId PK
        STRING campaignId PK
    }

    CampaignStatistics {
        STRING senderId PK
        STRING campaignId PK
    }

    %% RELAZIONI

    NotificationsRequest ||--|| pn_Notifications : "1:1"

    %% RaddTransactionEntity.transactionId = OperationsIunEntity.transactionId
    RaddTransactionEntity ||--o{ OperationsIunEntity : "1:N"

    %% RaddRegistryV2.partnerId = RaddTransactionEntity.partnerId AND RaddRegistryV2.locationId = RaddTransactionEntity.locationId
    RaddRegistryV2 ||--o{ RaddTransactionEntity : "1:N"

    %% Operazioni ACT: stampa atti notificati
    %% pn_Notifications.iun = RaddTransactionEntity.iun
    pn_Notifications ||--o{ RaddTransactionEntity : "1:N"

    %% Operazioni AOR: accesso a notifica per irreperibile
    %% OperationsIunEntity.iun = pn_Notifications.iun
    pn_Notifications ||--o{ OperationsIunEntity : "1:N"

    %% Join a livello di notifica: pn_Notifications.iun = pn_Timeline.iun
    %% Join a livello di destinatario: pn_Notifications.iun = pn_Timeline.iun AND pn_Timeline.recIndex identifica il destinatario della notifica
    pn_Notifications ||--o{ pn_Timeline : "1:N"

    %% pn_Notifications.recipients[].recipientId = UserAttributes.recipientId
    %% Una notifica può avere più destinatari e un destinatario può comparire in più notifiche
    pn_Notifications }o--o{ pn_UserAttributes : "N:M"

    %% pn_EcRichieste.XPagopaExtchCxId = pn_EcAnagrafica.cxId
    pn_EcAnagrafica ||--o{ pn_EcRichieste : "1:N"

    %% pn_EcRichiesteMetadati.XPagopaExtchCxId = pn_EcAnagrafica.cxId
    pn_EcAnagrafica ||--o{ pn_EcRichiesteMetadati : "1:N"

    %% pn_EcRichieste.requestId = pn_EcRichiesteMetadati.requestId
    pn_EcRichieste ||--|| pn_EcRichiesteMetadati : "1:1"

    %% pn_EcRichieste.requestId = pn_EcRichiesteConversione.requestId
    pn_EcRichieste o|--|| pn_EcRichiesteConversione : "0..1:1"

    %% pn_EcConversionePDF.requestId = pn_EcRichiesteConversione.requestId
    pn_EcRichiesteConversione ||--o{ pn_EcConversionePDF : "1:N"

    %% pn_Timeline.timelineElementId = transform(pn_EcRichiesteMetadati.requestId)
    %% (rimozione prefisso fino a "~", PREPARE_* -> SEND_*, rimozione suffisso .PCRETRY_<n>)
    %% Un elemento timeline può essere associato a più record di postalizzazione (retry)
    pn_Timeline ||--o{ pn_EcRichiesteMetadati : "1:N"

    %% Deleghe.Deleghe_pk = pn_UserAttributes.recipientId (delegante)
    %% Deleghe.s_delegate = pn_UserAttributes.recipientId (delegato)
    %% Nota: I campi Deleghe_pk e s_delegate non sono esportati nel Data Lake tramite dc-pn-mandate.yaml.
    %%       Sono tuttavia verificabili tramite pn_mandate_json_view in Athena.
    pn_UserAttributes }o--o{ Deleghe : "N:M"

    %% Deleghe.a_iuns[].iun = pn_Notifications.iun
    %% Relazione valorizzata principalmente per deleghe CIE
    Deleghe }o--o{ pn_Notifications : "N:M"

        %% COMUNICAZIONI BONARIE

    %% NotificationsRequest.requestId = NotificationInformal.requestId
    %% NotificationsRequest.iun e NotificationInformal.iun hanno semantica differente
    NotificationsRequest ||--|| NotificationInformal : "1:1"

    %% Join a livello di comunicazione: NotificationInformal.iun = TimelinesInformal.iun
    %% Join a livello di destinatario: NotificationInformal.iun = TimelinesInformal.iun AND TimelinesInformal.recIndex identifica il destinatario della comunicazione
    NotificationInformal ||--o{ TimelinesInformal : "1:N"

    %% NotificationInformal.campaignId = Campaigns.campaignId
    NotificationInformal }o--|| Campaigns : "N:1"

    %% NotificationInformal.campaignId = CampaignStatistics.campaignId
    NotificationInformal }o--|| CampaignStatistics : "N:1"

    %% TimelinesInformal.campaignId = CampaignStatistics.campaignId
    TimelinesInformal }o--|| CampaignStatistics : "N:1"

    %% Campaigns.senderId = CampaignStatistics.senderId
    %% Campaigns.campaignId = CampaignStatistics.campaignId
    Campaigns ||--|| CampaignStatistics : "1:1"

    %% STILE

    style NotificationsRequest fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style pn_UserAttributes fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style pn_Notifications fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style pn_Timeline fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style RaddRegistryV2 fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style RaddTransactionEntity fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style OperationsIunEntity fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style pn_EcAnagrafica fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style pn_EcRichieste fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style pn_EcRichiesteMetadati fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style pn_EcRichiesteConversione fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style pn_EcConversionePDF fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
