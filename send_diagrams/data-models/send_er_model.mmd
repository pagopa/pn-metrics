erDiagram
    direction LR

    %% CORE SEND
    NOTIFICATIONS {
        string iun PK
    }

    TIMELINE {
        string timelineElementId PK
        string iun FK
    }

    NOTIFICATIONS_REQUEST {
        string iun PK
    }

    %% PN-EC (minimal)
    PN_EC_RICHIESTE_METADATA {
        string requestId PK
    }

    %% RELAZIONI
    NOTIFICATIONS ||--o{TIMELINE : "1:N"
    NOTIFICATIONS_REQUEST ||--|| NOTIFICATIONS : "1:1"

    PN_EC_RICHIESTE_METADATA}o--|| TIMELINE : "N:1 (derived from requestId to timelineElementId)"

    %% STYLE
    style NOTIFICATIONS fill:#FFFFFF,stroke:#000000,color:#000000
    style TIMELINE fill:#FFFFFF,stroke:#000000,color:#000000
    style NOTIFICATIONS_REQUEST fill:#FFFFFF,stroke:#000000,color:#000000
    style PN_EC_RICHIESTE_METADATA fill:#FFFFFF,stroke:#000000,color:#000000