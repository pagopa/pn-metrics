    style TimelinesInformal fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style Campaigns fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    style CampaignStatistics fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000