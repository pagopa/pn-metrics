    %% - dc-radd-transaction-entity.yaml
    %%   id: urn:send:radd-alt:dc-radd-transaction-entity
    %%   version: 0.0.1
    %% - dc-radd-registry.yaml
    %%   id: urn:send:radd-alt:dc-radd-registry
    %%   version: 0.0.1
    %% - dc-operations-iuns-entity.yaml
    %%   id: urn:send:radd-alt:dc-operations-iuns-entity
    %%   version: 0.0.1
    %% - dc-pn-EcRichiesteMetadati.yaml
    %%   id: urn:send:postalizzazione:pn-ecrichiestemetadati
    %%   version: 0.0.1
    %% - dc-pn-user-attributes.yaml
    %%   id: urn:send:recapiti-deleghe:user-attributes
