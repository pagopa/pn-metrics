%% version: v1.0.0
%% source: dc-pn-timeline.yaml (layout ottimizzato orizzontale)
%%{init: {
  "theme": "base",
  "themeVariables": {
    "labelBackgroundColor": "#FFFFFF",
    "labelTextColor": "#000000",
    "entityBkgColor": "#FFFFFF",
    "attributeBkgColor": "#FFFFFF",
    "background": "#FFFFFF"
  }
}}%%
erDiagram
    direction LR

    %% ========================
    %% LEFT: STATUS / LEGAL
    %% ========================
    STATUS_INFO {
        string actual
        timestamp statusChangeTimestamp
        boolean statusChanged
    }

    LEGAL_FACT {
        string category
        string key
    }

    %% ========================
    %% CENTER: CORE
    %% ========================
    TIMELINE {
        string timelineElementId PK
        string category
        timestamp businessTimestamp
        string iun
        timestamp notificationSentAt
        string paId
        timestamp timestamp
        string reworkId
    }

    DETAILS {
        string aarKey
        string aarTemplateType
        int amount
        timestamp completionWorkflowDate
        string creditorTaxId
        object delegateInfo
        timestamp eventTimestamp
        string nextDigitalAddressSource
        timestamp nextLastAttemptMadeForSource
        int nextSourceAttemptsMade
        string noticeCode
        string paymentSourceChannel
        string prepareRequestId
        string recipientType
        timestamp schedulingDate
        timestamp sendDate
        string sendRequestId
        int analogCost
        int numberOfPages
        int envelopeWeight
        timestamp attemptDate
        string contactPhase
        string deliveryMode
        object digitalAddress
        string digitalAddressSource
        object downstreamId
        string deliveryFailureCause
        string deliveryDetailCode
        string generatedAarUrl
        boolean isAvailable
        timestamp lastAttemptDate
        object newAddress
        int notificationCost
        timestamp notificationDate
        object physicalAddress
        string productType
        string raddTransactionId
        string raddType
        string reason
        string reasonCode
        int recIndex
        string relatedRequestId
        string requestTimelineId
        string responseStatus
        int retryNumber
        int sentAttemptMade
        string serviceLevel
        boolean shouldRetry
        int numberOfRecipients
        string ioSendMessageResult
        array f24Attachments
        boolean isFirstSendRetry
        string relatedFeedbackTimelineId
        array refusalReasons
        boolean uncertainPaymentDate
        timestamp legalFactGenerationDate
        string registeredLetterCode
        timestamp schedulingAnalogDate
        string cancellationRequestId
        array notRefinedRecipientIndexes
        string failureCause
        int vat
        object categorizedAttachmentsResult
        array invalidatedTimelineAndStatusHistory
    }

    ATTACHMENT {
        string date
        string documentType
        string id
        string url
    }

    SENDING_RECEIPT {
        string id
        string system
    }

    REFUSAL_REASON {
        string errorCode
        string detail
    }

    %% RELAZIONI
    STATUS_INFO }o--|| TIMELINE : ""
    LEGAL_FACT }o--|| TIMELINE : ""

    TIMELINE ||--o| DETAILS : ""

    DETAILS ||--o{ ATTACHMENT : ""
    DETAILS ||--o{ SENDING_RECEIPT : ""
    DETAILS ||--o{ REFUSAL_REASON : ""

    %% STYLE
    style TIMELINE fill:#FFFFFF,stroke:#000000,color:#000000
    style STATUS_INFO fill:#FFFFFF,stroke:#000000,color:#000000
    style LEGAL_FACT fill:#FFFFFF,stroke:#000000,color:#000000
    style DETAILS fill:#FFFFFF,stroke:#000000,color:#000000
    style ATTACHMENT fill:#FFFFFF,stroke:#000000,color:#000000
    style SENDING_RECEIPT fill:#FFFFFF,stroke:#000000,color:#000000
    style REFUSAL_REASON fill:#FFFFFF,stroke:#000000,color:#000000