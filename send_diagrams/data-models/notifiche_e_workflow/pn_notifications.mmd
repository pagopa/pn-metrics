%% version: v1.0.0
%% source: dc-pn-Notifications.yaml
%%{init: {
  "theme": "base",
  "themeVariables": {
    "labelBackgroundColor": "#FFFFFF",
    "labelTextColor": "#000000",
    "entityBkgColor": "#FFFFFF",
    "attributeBkgColor": "#FFFFFF",
    "background": "#FFFFFF"
  }
}}%%
erDiagram
    direction LR

    NOTIFICATIONS {
        string iun PK
        int amount
        string cancelledByIun
        string cancelledIun
        string group
        string idempotenceToken
        string abstract
        string notificationFeePolicy
        string pagoPaIntMode
        string paNotificationId
        string paymentExpirationDate
        string physicalCommunicationType
        string senderDenomination
        string senderPaId
        string senderTaxId
        timestamp sentAt
        string sourceChannel
        string sourceChannelDetails
        string subject
        string taxonomyCode
        int paFee
        int vat
        string version
        int senderPriority
        string requestId
    }

    NOTIFICATIONS_REQUEST {
        string iun PK
        string requestId
    }

    LANGUAGE {
        string lang
    }

    USED_SERVICES {
        boolean physicalAddressLookup
    }

    %% DOCUMENTI
    DOCUMENT {
        string contentType
        string title
        boolean requiresAck
        boolean sendByMail
    }

    DOCUMENT_DIGESTS {
        string sha256
    }

    DOCUMENT_REF {
        string key
        string versionToken
    }

    %% RECIPIENT + PAGAMENTI
    RECIPIENT {
        string recipientId
        string recipientType
        string denomination
    }

    DIGITAL_DOMICILE {
        string type
    }

    PAYMENT {
        string creditorTaxId
        string noticeCode
        boolean applyCost
    }

    %% PagoPA
    PAGOPA_FORM {
        string contentType
    }

    PAGOPA_DIGESTS {
        string sha256
    }

    PAGOPA_REF {
        string key
        string versionToken
    }

    %% F24
    F24 {
        string title
        boolean applyCost
    }

    F24_META {
        string contentType
    }

    F24_DIGESTS {
        string sha256
    }

    F24_REF {
        string key
        string versionToken
    }

    %% RELAZIONI
    NOTIFICATIONS ||--|| NOTIFICATIONS_REQUEST : "1:1"

    NOTIFICATIONS ||--o{ DOCUMENT : ""
    DOCUMENT ||--o| DOCUMENT_DIGESTS : ""
    DOCUMENT ||--|| DOCUMENT_REF : ""

    NOTIFICATIONS ||--o{ RECIPIENT : ""
    RECIPIENT ||--o| DIGITAL_DOMICILE : ""
    RECIPIENT ||--o{ PAYMENT : ""

    NOTIFICATIONS ||--o{ LANGUAGE : ""
    NOTIFICATIONS ||--o| USED_SERVICES : ""

    %% ========================
    %% RELAZIONI PAGAMENTO
    %% ========================
    PAYMENT ||--o| PAGOPA_FORM : ""
    PAGOPA_FORM ||--o| PAGOPA_DIGESTS : ""
    PAGOPA_FORM ||--o| PAGOPA_REF : ""

    PAYMENT ||--o| F24 : ""
    F24 ||--o| F24_META : ""
    F24_META ||--o| F24_DIGESTS : ""
    F24_META ||--o| F24_REF : ""

    %% STYLE
    style NOTIFICATIONS fill:#FFFFFF,stroke:#000000,color:#000000
    style NOTIFICATIONS_REQUEST fill:#FFFFFF,stroke:#000000,color:#000000
    style DOCUMENT fill:#FFFFFF,stroke:#000000,color:#000000
    style DOCUMENT_DIGESTS fill:#FFFFFF,stroke:#000000,color:#000000
    style DOCUMENT_REF fill:#FFFFFF,stroke:#000000,color:#000000
    style RECIPIENT fill:#FFFFFF,stroke:#000000,color:#000000
    style DIGITAL_DOMICILE fill:#FFFFFF,stroke:#000000,color:#000000
    style PAYMENT fill:#FFFFFF,stroke:#000000,color:#000000
    style PAGOPA_FORM fill:#FFFFFF,stroke:#000000,color:#000000
    style PAGOPA_DIGESTS fill:#FFFFFF,stroke:#000000,color:#000000
    style PAGOPA_REF fill:#FFFFFF,stroke:#000000,color:#000000
    style F24 fill:#FFFFFF,stroke:#000000,color:#000000
    style F24_META fill:#FFFFFF,stroke:#000000,color:#000000
    style F24_DIGESTS fill:#FFFFFF,stroke:#000000,color:#000000
    style F24_REF fill:#FFFFFF,stroke:#000000,color:#000000
    style LANGUAGE fill:#FFFFFF,stroke:#000000,color:#000000
    style USED_SERVICES fill:#FFFFFF,stroke:#000000,color:#000000