        string receiverFiscalCode
        string receiverName
        string receiverNameRow2
        string receiverPr
        string senderAddress
        string senderCity
        string senderDigitalAddress
        string senderName
        string senderPr
    }

    %% RELAZIONI
    
    pn_EcAnagrafica ||--|| senderPhysicalAddress : ""
    
    %% pn_EcRichiesteMetadati.XPagopaExtchCxId = pn_EcAnagrafica.cxId
    pn_EcAnagrafica ||--o{ pn_EcRichiesteMetadati : "1:N"

    %% pn_EcRichieste.XPagopaExtchCxId = pn_EcAnagrafica.cxId
    pn_EcAnagrafica ||--o{ pn_EcRichieste : "1:N"

    %% pn_EcRichieste.requestId = pn_EcRichiesteMetadati.requestId
    pn_EcRichieste ||--|| pn_EcRichiesteMetadati : "1:1"

    pn_EcRichieste ||--|| digitalRequestPersonal : ""
    pn_EcRichieste ||--|| paperRequestPersonal : ""

    %% pn_EcRichieste.requestId = pn_EcRichiesteConversione.requestId
    pn_EcRichieste o|--|| pn_EcRichiesteConversione : "0..1 : 1"

    %% pn_EcConversionePDF.requestId = pn_EcRichiesteConversione.requestId
    pn_EcRichiesteConversione ||--o{ pn_EcConversionePDF : "1:N"

    %% pn_EcRichiesteMetadati.digitalRequestMetadata
    pn_EcRichiesteMetadati ||--o| digitalRequestMetadata : "0..1"

    %% pn_EcRichiesteMetadati.paperRequestMetadata
    pn_EcRichiesteMetadati ||--o| paperRequestMetadata : "0..1"

    %% pn_EcRichiesteMetadati.eventsList[*]
    pn_EcRichiesteMetadati ||--o{ eventsList : "1:N"
    
