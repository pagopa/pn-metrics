        object digitalRequestMetadata
        object paperRequestMetadata
        string requestHash "NOT NULL"
        string requestTimestamp "NOT NULL"
        string statusRequest "NOT NULL"
        long version "NOT NULL"
        string lastUpdateTimestamp "NOT NULL"
        string messageId
        string XPagopaExtchCxId "NOT NULL"
    }

    digitalRequestMetadata {
        string channel "NOT NULL"
        string correlationId "NOT NULL"
        string eventType "NOT NULL"
        string messageContentType "NOT NULL"
        string tags
    }

    paperRequestMetadata {
        string iun
        string printType
        string productType
        string requestPaId
        string vas
    }

    eventsList {
        object digProgrStatus
        string insertTimestamp "NOT NULL"
        object paperProgrStatus
    }

    pn_EcAnagrafica {
        string cxId PK "NOT NULL"
        string apiKey
        string mailReplyTo "NOT NULL"
        string pecReplyTo "NOT NULL"
        object senderPhysicalAddress "NOT NULL"
        string sqsArn "NOT NULL"
        string sqsName "NOT NULL"
    }

    senderPhysicalAddress {
        string address
        string cap
        string city
        string name
        string pr
    }

    pn_EcRichieste {
        string requestId PK "NOT NULL"
        string clientRequestTimeStamp "NOT NULL"
        object digitalRequestPersonal
        object paperRequestPersonal
        string requestTimestamp "NOT NULL"
        string XPagopaExtchCxId "NOT NULL"
    }

    pn_EcRichiesteConversione {
        string requestId PK
        string clientId
        string requestTimestamp
        array attachments
